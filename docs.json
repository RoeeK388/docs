{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Jurni",
  "colors": {
    "primary": "#FB4E26",
    "light": "#ffffff",
    "dark": "#FB4E26"
  },
  "favicon": {
    "light": "/images/black1.svg",
    "dark": "/images/white1.svg"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Changelog",
          "href": "/changelog",
          "icon": "rocket"
        }
      ]
    },
    "anchors": [
      {
        "anchor": "Academy",
        "icon": "graduation-cap",
        "href": "/academy"
      },
      {
        "anchor": "Guides",
        "icon": "book-open",
        "href": "/guides"
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard ->",
      "href": "https://app.getjurni.ai"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/jurni__ai"
    }
  },
  "logo": {
    "light": "/images/Icon5.png",
    "dark": "/images/white5.png",
    "href": "https://getjurni.ai"
  },
  "background": {
    "color": {
      "dark": "#000000"
    }
  },
  "fonts": {
    "heading": {
      "family": "Inter",
      "weight": 500
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "interaction": {
    "drilldown": true
  },
  "icons": {
    "library": "lucide"
  }
}
